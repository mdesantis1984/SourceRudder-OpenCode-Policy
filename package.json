{
  "name": "opencode-sourcerudder-policy",
  "version": "1.0.0",
  "private": false,
  "license": "MIT",
  "description": "Upgrade-safe SourceRudder-first policy plugin for OpenCode 1.18.26",
  "type": "module",
  "main": "dist/index.js",
  "files": [
    "dist/index.js",
    "dist/sourcerudder-policy-v1.0.0.js",
    "README.es.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mdesantis1984/SourceRudder-OpenCode-Policy.git"
  },
  "homepage": "https://github.com/mdesantis1984/SourceRudder-OpenCode-Policy#readme",
  "bugs": {
    "url": "https://github.com/mdesantis1984/SourceRudder-OpenCode-Policy/issues"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && node scripts/build.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "npm run build && node --test dist/test/*.test.js",
    "check:package": "node scripts/check-package.mjs",
    "check:docs": "node scripts/check-docs.mjs",
    "check:history": "node scripts/check-history.mjs",
    "check:public": "node scripts/check-history.mjs --public",
    "check": "npm run check:history && npm run typecheck && npm test && npm run check:package",
    "release:prepare": "npm run check && npm run check:docs && node scripts/prepare-release.mjs",
    "prepublishOnly": "npm run check && npm run check:docs"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@opencode-ai/plugin": "1.18.26",
    "@types/node": "^22.10.2",
    "esbuild": "^0.24.2",
    "typescript": "^5.7.3"
  }
}
